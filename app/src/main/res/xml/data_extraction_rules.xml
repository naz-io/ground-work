<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 (API 31) and higher.
   The Room database is excluded from cloud backup: restoring an older snapshot would bring
   back stale sync states, such as pending creates that were already synced. Device-to-device
   transfer copies the current database, so it keeps the default of including everything.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="groundwork.db" />
        <exclude domain="database" path="groundwork.db-shm" />
        <exclude domain="database" path="groundwork.db-wal" />
        <exclude domain="database" path="groundwork.db-journal" />
    </cloud-backup>
</data-extraction-rules>
