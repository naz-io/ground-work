<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 (API 30), which does not read data_extraction_rules.xml.
   Excludes the Room database for the same reason as the cloud-backup rules there.
-->
<full-backup-content>
    <exclude domain="database" path="groundwork.db" />
    <exclude domain="database" path="groundwork.db-shm" />
    <exclude domain="database" path="groundwork.db-wal" />
    <exclude domain="database" path="groundwork.db-journal" />
</full-backup-content>
